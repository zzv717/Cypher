# Bu faylni nusxa ko'chirib .env deb nomlang va o'z API kalitlaringizni kiriting
# Hech qachon .env faylini GitHub ga yuklamang!

# OpenAI (ChatGPT) kaliti - https://platform.openai.com/api-keys dan oling
OPENAI_API_KEY=

# Google Gemini kaliti - https://aistudio.google.com/app/apikey dan oling
GEMINI_API_KEY=

# Perplexity kaliti - https://www.perplexity.ai/settings/api dan oling
PERPLEXITY_API_KEY=

# Server porti
PORT=3000
